{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eucatur Play",
  "version": "2.1.4",
  "identifier": "app.westplay",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../ui",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "npm run build:release",
      "cwd": "../ui"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Eucatur Play",
        "width": 900,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "Comunidade Eucatur",
    "copyright": "Eucatur Play: versão modificada do WestPlay (© 2026 WestPlay, github.com/enes-less/WestPlay). GPL-3.0-or-later.",
    "category": "Game",
    "shortDescription": "Tela Eucatur nos caminhões do Euro Truck Simulator 2 (baseado no WestPlay)",
    "longDescription": "Eucatur Play coloca a tela da Comunidade Eucatur (GPS, documentos, cargas, banco e tacógrafo) e as funções do WestPlay (mapa, música, YouTube) na tela do próprio caminhão no Euro Truck Simulator 2. Versão modificada do WestPlay, software livre sob a GPL-3.0.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../ui/dist/": "ui/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNEQyRTk3RjA3OTFDQTMKUldTakhIbndseTVOdzZmU09KL0hldElnQkh0M2NCTVA3aVo4amtrQ0pnN2tuMzR6VWtweDZzbEoK",
      "endpoints": [
        "https://github.com/2910ale/eucatur-play/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "mainBinaryName": "westplay"
}
